  "rules": {
    "pathCompensation":"effective path radius = tool R + table DR + TOOL CALL DR; RL is left and RR is right relative to travel",
    "circularArc":"C runs on the circle through the start point around CC; CR selects the arc by end point and radius, R+ is the minor and R- the major arc, DR chooses rotation; under RL/RR the tool center follows the programmed arc offset by the effective path radius toward the compensation side; an arc without RL/RR follows the programmed arc directly",
    "physicalMill":"physical radius = tool R + table DR; TOOL CALL DR does not resize the physical cutter",
    "programmedLength":"physical cut Z = programmed path Z + TOOL CALL DL; table DL is measured compensation and does not independently alter the workpiece",
    "ball":"R2=R produces a spherical bottom with radius R2",
    "countersink":"cone radius at height h above the tip is Rtip + h*tan(T-ANGLE/2), limited by LCUTS*tan(T-ANGLE/2)",
    "cycle208PathOverlap":"Q370=0 selects automatic path distribution; Q370>0 sets stepover k = Q370 x active tool radius; supported input is 0 or 0.1...1999",
    "cycle209Orientation":"Q336 spindle orientation input is 0...360 degrees",
    "voxelTolerance":"path values use 1e-6 mm; voxel floor uses one observed Z cell; measured width allows one observed cell at each boundary"
  },
